local function P(n, s, p, c, m, par, cl)
    local x = Instance.new("Part")
    x.Name = n
    x.Size = s
    x.Position = p
    x.Anchored = true
    x.CanCollide = cl ~= false
    x.Color = c
    x.Material = m or Enum.Material.SmoothPlastic
    x.Parent = par
    return x
end

_G.BarnyPortal.P = P

-- ========== ПОРТАЛ (как на 2-й картинке) ==========
local function CreatePortal(parent, pos, faceTowards, name, color)
    local m = Instance.new("Model")
    m.Name = name
    local col = color or _G.BarnyPortal.PortalColor
    
    local lookCF = CFrame.lookAt(pos, Vector3.new(faceTowards.X, pos.Y, faceTowards.Z))
    
    -- ОСНОВА (ровный круг через Sphere + SpecialMesh)
    local portal = P("Oval", Vector3.new(9, 9, 0.3), pos, col, Enum.Material.Neon, m)
    portal.Shape = Enum.PartType.Ball
    portal.CFrame = lookCF
    portal.CanCollide = false
    portal.CanTouch = true
    portal.Transparency = 0.1
    
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = Vector3.new(1, 1, 0.05)
    mesh.Parent = portal
    
    -- ВНУТРЕННИЙ ВИХРЬ
    local inner = P("Inner", Vector3.new(8.5, 8.5, 0.4), pos, Color3.fromRGB(20, 100, 20), Enum.Material.SmoothPlastic, m)
    inner.Shape = Enum.PartType.Ball
    inner.CFrame = lookCF
    inner.CanCollide = false
    inner.CanTouch = false
    inner.Transparency = 0.2
    
    local innerMesh = Instance.new("SpecialMesh")
    innerMesh.MeshType = Enum.MeshType.Sphere
    innerMesh.Scale = Vector3.new(1, 1, 0.05)
    innerMesh.Parent = inner
    
    -- СПИРАЛЬ (текстура)
    local swirl = P("Swirl", Vector3.new(8, 8, 0.5), pos, col, Enum.Material.Neon, m)
    swirl.Shape = Enum.PartType.Ball
    swirl.CFrame = lookCF
    swirl.CanCollide = false
    swirl.CanTouch = false
    swirl.Transparency = 0.15
    
    local swirlMesh = Instance.new("SpecialMesh")
    swirlMesh.MeshType = Enum.MeshType.Sphere
    swirlMesh.Scale = Vector3.new(1, 1, 0.05)
    swirlMesh.Parent = swirl
    
    local decal = Instance.new("Decal")
    decal.Texture = "rbxassetid://131237241"
    decal.Face = Enum.NormalId.Front
    decal.Transparency = 0.2
    decal.Color3 = col
    decal.Parent = swirl
    
    local decal2 = Instance.new("Decal")
    decal2.Texture = "rbxassetid://131237241"
    decal2.Face = Enum.NormalId.Back
    decal2.Transparency = 0.2
    decal2.Color3 = col
    decal2.Parent = swirl
    
    -- БЕЛЫЕ ТОЧКИ
    for i = 1, 30 do
        local angle = math.random() * math.pi * 2
        local radius = math.random(10, 40) / 10
        local x = math.cos(angle) * radius
        local y = math.sin(angle) * radius
        
        local spot = P("Spot"..i, Vector3.new(0.5, 0.5, 0.5), pos, Color3.fromRGB(255, 255, 255), Enum.Material.Neon, m)
        spot.Shape = Enum.PartType.Ball
        spot.CFrame = lookCF * CFrame.new(x, y, 0.35)
        spot.CanCollide = false
        spot.CanTouch = false
        spot.Transparency = math.random(20, 40) / 100
    end
    
    -- СВЕТ
    local light = Instance.new("PointLight")
    light.Color = col
    light.Range = 20
    light.Brightness = 4
    light.Parent = portal
    
    -- ВРАЩЕНИЕ СПИРАЛИ
    task.spawn(function()
        local spin = 0
        while swirl.Parent do
            spin = spin + 0.05
            swirl.CFrame = lookCF * CFrame.Angles(0, 0, spin)
            RS.Heartbeat:Wait()
        end
    end)
    
    m.PrimaryPart = portal
    m.Parent = parent
    return m, portal
end

_G.BarnyPortal.CreatePortal = CreatePortal

-- ========== ТЕЛЕПОРТ ==========
local function SetupTP(portal, target)
    local oval = portal:FindFirstChild("Oval")
    if not oval then return end
    oval.Touched:Connect(function(hit)
        local char = hit.Parent
        if not char or char ~= LP.Character then return end
        local now = os.clock()
        if now - _G.BarnyPortal.LastTP < _G.BarnyPortal.TELEPORT_CD then return end
        _G.BarnyPortal.LastTP = now
        local targetOval = target and target:FindFirstChild("Oval")
        if not targetOval then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(targetOval.Position + targetOval.CFrame.LookVector * 5)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

_G.BarnyPortal.SetupTP = SetupTP

-- ========== ПУШКА (маленький блоб) ==========
local function GivePortalGun()
    local char = LP.Character
    if not char then return end
    if _G.BarnyPortal.CurrentGun and _G.BarnyPortal.CurrentGun.Parent then _G.BarnyPortal.CurrentGun:Destroy() end
    
    local tool = Instance.new("Tool")
    tool.Name = "Portal Gun"
    tool.RequiresHandle = true
    
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.6, 0.8, 0.6)
    handle.Color = _G.BarnyPortal.PortalColor
    handle.Material = Enum.Material.Neon
    handle.Shape = Enum.PartType.Ball
    handle.Parent = tool
    
    local base = Instance.new("Part")
    base.Name = "Base"
    base.Size = Vector3.new(1.2, 0.4, 0.8)
    base.Color = Color3.fromRGB(240, 240, 240)
    base.Material = Enum.Material.SmoothPlastic
    base.CFrame = handle.CFrame * CFrame.new(0, -0.6, 0)
    base.Parent = tool
    local w1 = Instance.new("Weld")
    w1.Part0 = handle
    w1.Part1 = base
    w1.C0 = CFrame.new(0, -0.6, 0)
    w1.Parent = handle
    
    local crystal = Instance.new("Part")
    crystal.Name = "Crystal"
    crystal.Size = Vector3.new(0.7, 1.0, 0.7)
    crystal.Color = _G.BarnyPortal.PortalColor
    crystal.Material = Enum.Material.Neon
    crystal.Shape = Enum.PartType.Ball
    crystal.CFrame = handle.CFrame * CFrame.new(0, 0.3, 0)
    crystal.Parent = tool
    local w2 = Instance.new("Weld")
    w2.Part0 = handle
    w2.Part1 = crystal
    w2.C0 = CFrame.new(0, 0.3, 0)
    w2.Parent = handle
    
    local light = Instance.new("PointLight")
    light.Color = _G.BarnyPortal.PortalColor
    light.Range = 10
    light.Brightness = 5
    light.Parent = crystal
    
    local button = Instance.new("Part")
    button.Name = "Button"
    button.Size = Vector3.new(0.15, 0.15, 0.15)
    button.Color = Color3.fromRGB(255, 50, 50)
    button.Material = Enum.Material.Neon
    button.Shape = Enum.PartType.Ball
    button.CFrame = base.CFrame * CFrame.new(-0.4, 0.15, 0.3)
    button.Parent = tool
    local w3 = Instance.new("Weld")
    w3.Part0 = handle
    w3.Part1 = button
    w3.C0 = CFrame.new(-0.4, -0.45, 0.3)
    w3.Parent = handle
    
    local antenna = Instance.new("Part")
    antenna.Name = "Antenna"
    antenna.Size = Vector3.new(0.15, 0.5, 0.15)
    antenna.Color = Color3.fromRGB(40, 40, 40)
    antenna.Material = Enum.Material.SmoothPlastic
    antenna.CFrame = base.CFrame * CFrame.new(0.4, 0.4, 0)
    antenna.Parent = tool
    local w4 = Instance.new("Weld")
    w4.Part0 = handle
    w4.Part1 = antenna
    w4.C0 = CFrame.new(0.4, -0.2, 0)
    w4.Parent = handle
    
    tool.Activated:Connect(function()
        local c = tool.Parent
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        if _G.BarnyPortal.Mode == "Normal" then
            if _G.BarnyPortal.NextPortal == "A" then
                local forward = hrp.CFrame.LookVector
                local spawnPos = hrp.Position + forward * 8
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {c}
                local groundCheck = workspace:Raycast(spawnPos + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0), rp)
                if groundCheck then
                    spawnPos = Vector3.new(spawnPos.X, groundCheck.Position.Y + 5, spawnPos.Z)
                end
                local faceTowards = hrp.Position
                if _G.BarnyPortal.PortalA and _G.BarnyPortal.PortalA.Parent then _G.BarnyPortal.PortalA:Destroy() end
                _G.BarnyPortal.PortalA = CreatePortal(workspace, spawnPos, faceTowards, "PortalA", _G.BarnyPortal.PortalColor)
                _G.BarnyPortal.NextPortal = "B"
            else
                local cam = workspace.CurrentCamera
                local origin = cam.CFrame.Position
                local direction = cam.CFrame.LookVector * 200
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {c}
                local res = workspace:Raycast(origin, direction, rp)
                if not res then return end
                local hp = res.Position
                local faceTowards = hrp.Position
                if _G.BarnyPortal.PortalB and _G.BarnyPortal.PortalB.Parent then _G.BarnyPortal.PortalB:Destroy() end
                _G.BarnyPortal.PortalB = CreatePortal(workspace, hp, faceTowards, "PortalB", _G.BarnyPortal.PortalColor)
                _G.BarnyPortal.NextPortal = "A"
            end
            if _G.BarnyPortal.PortalA and _G.BarnyPortal.PortalB then
                SetupTP(_G.BarnyPortal.PortalA, _G.BarnyPortal.PortalB)
                SetupTP(_G.BarnyPortal.PortalB, _G.BarnyPortal.PortalA)
            end
        else
            if _G.BarnyPortal.EnterDimension then
                _G.BarnyPortal.EnterDimension(hrp)
            end
        end
    end)
    
    tool.Parent = LP:WaitForChild("Backpack")
    char.Humanoid:EquipTool(tool)
    _G.BarnyPortal.CurrentGun = tool
end

_G.BarnyPortal.GivePortalGun = GivePortalGun

