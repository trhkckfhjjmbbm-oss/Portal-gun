local function P(n, s, p, c, m, par, cl)
    local x = Instance.new("Part")
    x.Name = n
    x.Size = s
    x.Position = p
    x.Anchored = true
    x.CanCollide = cl ~= false
    x.Color = c
    x.Material = m or Enum.Material.SmoothPlastic
    x.Parent = par
    return x
end

_G.BarnyPortal.P = P

-- ========== ПОРТАЛ-ПОЛУСФЕРА (как на 1-й картинке) ==========
local function CreatePortal(parent, pos, normal, name, color)
    local m = Instance.new("Model")
    m.Name = name
    local col = color or _G.BarnyPortal.PortalColor
    
    -- Выравниваем по нормали
    local lookCF = CFrame.lookAt(pos, pos + normal)
    
    -- ===== ПОЛУСФЕРА (главная форма) =====
    -- Используем Sphere + SpecialMesh со Scale (1, 0.5, 1) → полусфера
    local dome = P("Oval", Vector3.new(9, 9, 9), pos, col, Enum.Material.Neon, m)
    dome.Shape = Enum.PartType.Ball
    dome.CFrame = lookCF * CFrame.new(0, 0, 0)
    dome.CanCollide = false
    dome.CanTouch = true
    dome.Transparency = 0.3
    
    local domeMesh = Instance.new("SpecialMesh")
    domeMesh.MeshType = Enum.MeshType.Sphere
    domeMesh.Scale = Vector3.new(1, 0.5, 1) -- полусфера
    domeMesh.Parent = dome
    
    -- ===== ВНУТРЕННЯЯ ПОЛУСФЕРА (тёмнее) =====
    local inner = P("Inner", Vector3.new(8, 8, 8), pos, Color3.fromRGB(20, 100, 80), Enum.Material.SmoothPlastic, m)
    inner.Shape = Enum.PartType.Ball
    inner.CFrame = lookCF * CFrame.new(0, -0.1, 0)
    inner.CanCollide = false
    inner.CanTouch = false
    inner.Transparency = 0.5
    
    local innerMesh = Instance.new("SpecialMesh")
    innerMesh.MeshType = Enum.MeshType.Sphere
    innerMesh.Scale = Vector3.new(1, 0.45, 1)
    innerMesh.Parent = inner
    
    -- ===== РАМКА (тонкое кольцо у основания) =====
    local rim = P("Rim", Vector3.new(0.2, 9, 9), pos, col, Enum.Material.Neon, m)
    rim.Shape = Enum.PartType.Cylinder
    rim.CFrame = lookCF * CFrame.Angles(0, 0, math.rad(90))
    rim.CanCollide = false
    rim.CanTouch = false
    rim.Transparency = 0.2
    
    -- ===== БЕЛЫЕ ТОЧКИ (внутри и снаружи) =====
    for i = 1, 40 do
        local angle = math.random() * math.pi * 2
        local radius = math.random(10, 45) / 10
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius
        local y = math.sqrt(math.max(0, 4.5^2 - x^2 - z^2)) * 0.5 -- по полусфере
        
        local spot = P("Spot"..i, Vector3.new(0.4, 0.4, 0.4), pos, Color3.fromRGB(255, 255, 255), Enum.Material.Neon, m)
        spot.Shape = Enum.PartType.Ball
        spot.CFrame = lookCF * CFrame.new(x, y, z)
        spot.CanCollide = false
        spot.CanTouch = false
        spot.Transparency = math.random(30, 70) / 100
    end
    
    -- ===== СВЕТ =====
    local light = Instance.new("PointLight")
    light.Color = col
    light.Range = 25
    light.Brightness = 4
    light.Parent = dome
    
    m.PrimaryPart = dome
    m.Parent = parent
    return m, dome
end

_G.BarnyPortal.CreatePortal = CreatePortal

-- ========== ТЕЛЕПОРТ ==========
local function SetupTP(portal, target)
    local dome = portal:FindFirstChild("Oval")
    if not dome then return end
    dome.Touched:Connect(function(hit)
        local char = hit.Parent
        if not char or char ~= LP.Character then return end
        local now = os.clock()
        if now - _G.BarnyPortal.LastTP < _G.BarnyPortal.TELEPORT_CD then return end
        _G.BarnyPortal.LastTP = now
        local targetDome = target and target:FindFirstChild("Oval")
        if not targetDome then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(targetDome.Position + targetDome.CFrame.LookVector * 5)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

_G.BarnyPortal.SetupTP = SetupTP

-- ========== ПУШКА (скин ЗЛОЙ МОРТИ) ==========
local function GivePortalGun()
    local char = LP.Character
    if not char then return end
    if _G.BarnyPortal.CurrentGun and _G.BarnyPortal.CurrentGun.Parent then _G.BarnyPortal.CurrentGun:Destroy() end
    
    local tool = Instance.new("Tool")
    tool.Name = "Portal Gun"
    tool.RequiresHandle = true
    
    local col = _G.BarnyPortal.PortalColor
    local skin = _G.BarnyPortal.Skin
    
    -- Цвета для скинов
    local handleColor, bodyColor, headColor, gripColor, orbColor, eyeColor, flaskColor
    
    if skin == "EvilMorty" then
        -- Злой Морти — грязно-жёлтый (оливковый)
        handleColor = Color3.fromRGB(180, 170, 50)
        bodyColor = Color3.fromRGB(200, 190, 60)
        headColor = Color3.fromRGB(160, 150, 40)
        gripColor = Color3.fromRGB(60, 60, 30)
        orbColor = Color3.fromRGB(255, 240, 100)
        eyeColor = Color3.fromRGB(50, 150, 220)
        flaskColor = Color3.fromRGB(255, 240, 100)
    else
        handleColor = Color3.fromRGB(180, 180, 180)
        bodyColor = Color3.fromRGB(200, 200, 200)
        headColor = Color3.fromRGB(160, 160, 160)
        gripColor = Color3.fromRGB(160, 160, 160)
        orbColor = col
        eyeColor = Color3.fromRGB(40, 40, 40)
        flaskColor = col
    end
    
    -- HANDLE
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.5, 1, 2)
    handle.Color = handleColor
    handle.Material = Enum.Material.SmoothPlastic
    handle.Parent = tool
    
    -- BODY
    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(1, 0.7, 2.5)
    body.Color = bodyColor
    body.Material = Enum.Material.SmoothPlastic
    body.CFrame = handle.CFrame * CFrame.new(0, 0.5, -0.8)
    body.Parent = tool
    local w1 = Instance.new("Weld")
    w1.Part0 = handle
    w1.Part1 = body
    w1.C0 = CFrame.new(0, 0.5, -0.8)
    w1.Parent = handle
    
    -- HEAD (передняя часть, кубическая)
    local head = Instance.new("Part")
    head.Name = "Head"
    head.Size = Vector3.new(1.2, 1.2, 1.2)
    head.Color = headColor
    head.Material = Enum.Material.SmoothPlastic
    head.CFrame = body.CFrame * CFrame.new(0, 0, -1.8)
    head.Parent = tool
    local w2 = Instance.new("Weld")
    w2.Part0 = handle
    w2.Part1 = head
    w2.C0 = CFrame.new(0, 0.5, -2.6)
    w2.Parent = handle
    
    -- EYE (синий глаз)
    local eye = Instance.new("Part")
    eye.Name = "Eye"
    eye.Size = Vector3.new(0.6, 0.6, 0.2)
    eye.Color = eyeColor
    eye.Material = Enum.Material.Neon
    eye.Shape = Enum.PartType.Cylinder
    eye.CFrame = head.CFrame * CFrame.new(0, 0, -0.65) * CFrame.Angles(0, math.rad(90), 0)
    eye.Parent = tool
    local w3 = Instance.new("Weld")
    w3.Part0 = handle
    w3.Part1 = eye
    w3.C0 = CFrame.new(0, 0.5, -3.25) * CFrame.Angles(0, math.rad(90), 0)
    w3.Parent = handle
    
    -- Ободок глаза (тёмный)
    local eyeRing = Instance.new("Part")
    eyeRing.Name = "EyeRing"
    eyeRing.Size = Vector3.new(0.8, 0.8, 0.1)
    eyeRing.Color = Color3.fromRGB(40, 40, 40)
    eyeRing.Material = Enum.Material.SmoothPlastic
    eyeRing.Shape = Enum.PartType.Cylinder
    eyeRing.CFrame = head.CFrame * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.rad(90), 0)
    eyeRing.Parent = tool
    local w4 = Instance.new("Weld")
    w4.Part0 = handle
    w4.Part1 = eyeRing
    w4.C0 = CFrame.new(0, 0.5, -3.2) * CFrame.Angles(0, math.rad(90), 0)
    w4.Parent = handle
    
    -- ORB (жёлтая сфера на конце)
    local orb = Instance.new("Part")
    orb.Name = "Orb"
    orb.Size = Vector3.new(0.7, 0.7, 0.7)
    orb.Color = orbColor
    orb.Material = Enum.Material.Neon
    orb.Shape = Enum.PartType.Ball
    orb.CFrame = head.CFrame * CFrame.new(0, 0, -0.9)
    orb.Parent = tool
    local w5 = Instance.new("Weld")
    w5.Part0 = handle
    w5.Part1 = orb
    w5.C0 = CFrame.new(0, 0.5, -3.5)
    w5.Parent = handle
    
    local orbLight = Instance.new("PointLight")
    orbLight.Color = orbColor
    orbLight.Range = 15
    orbLight.Brightness = 6
    orbLight.Parent = orb
    
    -- FLASK (колба сверху, из 2 частей: цилиндр + сфера)
    local flaskBase = Instance.new("Part")
    flaskBase.Name = "FlaskBase"
    flaskBase.Size = Vector3.new(0.5, 0.7, 0.5)
    flaskBase.Color = flaskColor
    flaskBase.Material = Enum.Material.Glass
    flaskBase.Transparency = 0.3
    flaskBase.Shape = Enum.PartType.Cylinder
    flaskBase.CFrame = body.CFrame * CFrame.new(0.3, 0.6, 0.3)
    flaskBase.Parent = tool
    local w6 = Instance.new("Weld")
    w6.Part0 = handle
    w6.Part1 = flaskBase
    w6.C0 = CFrame.new(0.3, 1.1, -0.5)
    w6.Parent = handle
    
    local flaskTop = Instance.new("Part")
    flaskTop.Name = "FlaskTop"
    flaskTop.Size = Vector3.new(0.6, 0.6, 0.6)
    flaskTop.Color = flaskColor
    flaskTop.Material = Enum.Material.Glass
    flaskTop.Transparency = 0.3
    flaskTop.Shape = Enum.PartType.Ball
    flaskTop.CFrame = flaskBase.CFrame * CFrame.new(0, 0.6, 0)
    flaskTop.Parent = tool
    local w7 = Instance.new("Weld")
    w7.Part0 = handle
    w7.Part1 = flaskTop
    w7.C0 = CFrame.new(0.3, 1.7, -0.5)
    w7.Parent = handle
    
    -- Крышка колбы
    local flaskCap = Instance.new("Part")
    flaskCap.Name = "FlaskCap"
    flaskCap.Size = Vector3.new(0.7, 0.15, 0.7)
    flaskCap.Color = Color3.fromRGB(200, 200, 200)
    flaskCap.Material = Enum.Material.SmoothPlastic
    flaskCap.Shape = Enum.PartType.Cylinder
    flaskCap.CFrame = flaskTop.CFrame * CFrame.new(0, 0.35, 0)
    flaskCap.Parent = tool
    local w8 = Instance.new("Weld")
    w8.Part0 = handle
    w8.Part1 = flaskCap
    w8.C0 = CFrame.new(0.3, 2.05, -0.5)
    w8.Parent = handle
    
    -- GRIP (рукоятка снизу)
    local grip = Instance.new("Part")
    grip.Name = "Grip"
    grip.Size = Vector3.new(0.4, 0.8, 1)
    grip.Color = gripColor
    grip.Material = Enum.Material.SmoothPlastic
    grip.CFrame = handle.CFrame * CFrame.new(0, -0.7, 0.3)
    grip.Parent = tool
    local w9 = Instance.new("Weld")
    w9.Part0 = handle
    w9.Part1 = grip
    w9.C0 = CFrame.new(0, -0.7, 0.3)
    w9.Parent = handle
    
    -- Красная кнопка (для оригинального скина)
    if skin == "Original" then
        local redBtn = Instance.new("Part")
        redBtn.Name = "RedButton"
        redBtn.Size = Vector3.new(0.4, 0.1, 0.3)
        redBtn.Color = Color3.fromRGB(220, 40, 40)
        redBtn.Material = Enum.Material.SmoothPlastic
        redBtn.CFrame = body.CFrame * CFrame.new(-0.3, 0.4, 0.3)
        redBtn.Parent = tool
        local w10 = Instance.new("Weld")
        w10.Part0 = handle
        w10.Part1 = redBtn
        w10.C0 = CFrame.new(-0.3, 0.9, -0.5)
        w10.Parent = handle
    end
    
    tool.Activated:Connect(function()
        local c = tool.Parent
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        if _G.BarnyPortal.Mode == "Normal" then
            if _G.BarnyPortal.NextPortal == "A" then
                local forward = hrp.CFrame.LookVector
                local spawnPos = hrp.Position + forward * 8
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {c}
                local groundCheck = workspace:Raycast(spawnPos + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0), rp)
                local normal = Vector3.new(0, 1, 0)
                if groundCheck then
                    spawnPos = Vector3.new(spawnPos.X, groundCheck.Position.Y + 3, spawnPos.Z)
                    normal = groundCheck.Normal
                end
                if _G.BarnyPortal.PortalA and _G.BarnyPortal.PortalA.Parent then _G.BarnyPortal.PortalA:Destroy() end
                _G.BarnyPortal.PortalA = CreatePortal(workspace, spawnPos, normal, "PortalA", _G.BarnyPortal.PortalColor)
                _G.BarnyPortal.NextPortal = "B"
            else
                local cam = workspace.CurrentCamera
                local origin = cam.CFrame.Position
                local direction = cam.CFrame.LookVector * 200
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {c}
                local res = workspace:Raycast(origin, direction, rp)
                if not res then return end
                local hp = res.Position
                local normal = res.Normal
                if _G.BarnyPortal.PortalB and _G.BarnyPortal.PortalB.Parent then _G.BarnyPortal.PortalB:Destroy() end
                _G.BarnyPortal.PortalB = CreatePortal(workspace, hp, normal, "PortalB", _G.BarnyPortal.PortalColor)
                _G.BarnyPortal.NextPortal = "A"
            end
            if _G.BarnyPortal.PortalA and _G.BarnyPortal.PortalB then
                SetupTP(_G.BarnyPortal.PortalA, _G.BarnyPortal.PortalB)
                SetupTP(_G.BarnyPortal.PortalB, _G.BarnyPortal.PortalA)
            end
        else
            if _G.BarnyPortal.EnterDimension then
                _G.BarnyPortal.EnterDimension(hrp)
            end
        end
    end)
    
    tool.Parent = LP:WaitForChild("Backpack")
    char.Humanoid:EquipTool(tool)
    _G.BarnyPortal.CurrentGun = tool
end

