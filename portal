local function P(n, s, p, c, m, par, cl)
    local x = Instance.new("Part")
    x.Name = n
    x.Size = s
    x.Position = p
    x.Anchored = true
    x.CanCollide = cl ~= false
    x.Color = c
    x.Material = m or Enum.Material.SmoothPlastic
    x.Parent = par
    return x
end

_G.BarnyPortal.P = P

-- ========== ПОРТАЛ (ложится на любую поверхность) ==========
local function CreatePortal(parent, pos, normal, name, color)
    local m = Instance.new("Model")
    m.Name = name
    local col = color or _G.BarnyPortal.PortalColor
    
    local lookCF = CFrame.lookAt(pos, pos + normal)
    
    local oval = P("Oval", Vector3.new(0.3, 9, 9), pos, col, Enum.Material.Neon, m)
    oval.Shape = Enum.PartType.Cylinder
    oval.CFrame = lookCF * CFrame.Angles(0, 0, math.rad(90))
    oval.CanCollide = false
    oval.CanTouch = true
    oval.Transparency = 0.1
    
    local inner = P("Inner", Vector3.new(0.4, 8, 8), pos, Color3.fromRGB(20, 100, 20), Enum.Material.SmoothPlastic, m)
    inner.Shape = Enum.PartType.Cylinder
    inner.CFrame = lookCF * CFrame.Angles(0, 0, math.rad(90))
    inner.CanCollide = false
    inner.CanTouch = false
    inner.Transparency = 0.2
    
    local swirl = P("Swirl", Vector3.new(0.35, 7.5, 7.5), pos, col, Enum.Material.Neon, m)
    swirl.Shape = Enum.PartType.Cylinder
    swirl.CFrame = lookCF * CFrame.Angles(0, 0, math.rad(90))
    swirl.CanCollide = false
    swirl.CanTouch = false
    swirl.Transparency = 0.15
    
    local tex = Instance.new("Texture")
    tex.Texture = "rbxassetid://131237241"
    tex.Face = Enum.NormalId.Right
    tex.Transparency = 0.1
    tex.Color3 = col
    tex.Parent = swirl
    
    local tex2 = Instance.new("Texture")
    tex2.Texture = "rbxassetid://131237241"
    tex2.Face = Enum.NormalId.Left
    tex2.Transparency = 0.1
    tex2.Color3 = col
    tex2.Parent = swirl
    
    for i = 1, 30 do
        local angle = math.random() * math.pi * 2
        local radius = math.random(10, 40) / 10
        local x = math.cos(angle) * radius
        local y = math.sin(angle) * radius
        
        local spot = P("Spot"..i, Vector3.new(0.5, 0.5, 0.5), pos, Color3.fromRGB(255, 255, 255), Enum.Material.Neon, m)
        spot.Shape = Enum.PartType.Ball
        spot.CFrame = lookCF * CFrame.new(x, y, 0.2)
        spot.CanCollide = false
        spot.CanTouch = false
        spot.Transparency = math.random(20, 40) / 100
    end
    
    local light = Instance.new("PointLight")
    light.Color = col
    light.Range = 20
    light.Brightness = 4
    light.Parent = oval
    
    task.spawn(function()
        local spin = 0
        while swirl.Parent do
            spin = spin + 0.05
            swirl.CFrame = lookCF * CFrame.Angles(0, 0, math.rad(90) + spin)
            RS.Heartbeat:Wait()
        end
    end)
    
    m.PrimaryPart = oval
    m.Parent = parent
    return m, oval
end

_G.BarnyPortal.CreatePortal = CreatePortal

-- ========== ТЕЛЕПОРТ ==========
local function SetupTP(portal, target)
    local oval = portal:FindFirstChild("Oval")
    if not oval then return end
    oval.Touched:Connect(function(hit)
        local char = hit.Parent
        if not char or char ~= LP.Character then return end
        local now = os.clock()
        if now - _G.BarnyPortal.LastTP < _G.BarnyPortal.TELEPORT_CD then return end
        _G.BarnyPortal.LastTP = now
        local targetOval = target and target:FindFirstChild("Oval")
        if not targetOval then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(targetOval.Position + targetOval.CFrame.LookVector * 5)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

_G.BarnyPortal.SetupTP = SetupTP

-- ========== ПУШКА (2 скина) ==========
local function GivePortalGun()
    local char = LP.Character
    if not char then return end
    if _G.BarnyPortal.CurrentGun and _G.BarnyPortal.CurrentGun.Parent then _G.BarnyPortal.CurrentGun:Destroy() end
    
    local tool = Instance.new("Tool")
    tool.Name = "Portal Gun"
    tool.RequiresHandle = true
    
    local col = _G.BarnyPortal.PortalColor
    local skin = _G.BarnyPortal.Skin
    
    -- Цвета для скинов
    local handleColor, bodyColor, headColor, gripColor, orbColor, eyeColor
    
    if skin == "Golden" then
        handleColor = Color3.fromRGB(200, 170, 50)
        bodyColor = Color3.fromRGB(220, 190, 60)
        headColor = Color3.fromRGB(180, 150, 40)
        gripColor = Color3.fromRGB(40, 40, 40)
        orbColor = Color3.fromRGB(255, 240, 100)
        eyeColor = Color3.fromRGB(40, 150, 220)
    else
        handleColor = Color3.fromRGB(180, 180, 180)
        bodyColor = Color3.fromRGB(200, 200, 200)
        headColor = Color3.fromRGB(160, 160, 160)
        gripColor = Color3.fromRGB(160, 160, 160)
        orbColor = col
        eyeColor = Color3.fromRGB(40, 40, 40)
    end
    
    -- HANDLE
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.5, 1, 2)
    handle.Color = handleColor
    handle.Material = Enum.Material.SmoothPlastic
    handle.Parent = tool
    
    -- BODY
    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(1, 0.7, 2.5)
    body.Color = bodyColor
    body.Material = Enum.Material.SmoothPlastic
    body.CFrame = handle.CFrame * CFrame.new(0, 0.5, -0.8)
    body.Parent = tool
    local w1 = Instance.new("Weld")
    w1.Part0 = handle
    w1.Part1 = body
    w1.C0 = CFrame.new(0, 0.5, -0.8)
    w1.Parent = handle
    
    -- HEAD (передняя часть)
    local head = Instance.new("Part")
    head.Name = "Head"
    head.Size = Vector3.new(1.2, 1, 1.2)
    head.Color = headColor
    head.Material = Enum.Material.SmoothPlastic
    head.CFrame = body.CFrame * CFrame.new(0, 0.1, -1.8)
    head.Parent = tool
    local w2 = Instance.new("Weld")
    w2.Part0 = handle
    w2.Part1 = head
    w2.C0 = CFrame.new(0, 0.6, -2.6)
    w2.Parent = handle
    
    -- EYE (глаз)
    local eye = Instance.new("Part")
    eye.Name = "Eye"
    eye.Size = Vector3.new(0.6, 0.6, 0.25)
    eye.Color = eyeColor
    eye.Material = Enum.Material.Neon
    eye.Shape = Enum.PartType.Cylinder
    eye.CFrame = head.CFrame * CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.rad(90), 0)
    eye.Parent = tool
    local w3 = Instance.new("Weld")
    w3.Part0 = handle
    w3.Part1 = eye
    w3.C0 = CFrame.new(0, 0.6, -3.2) * CFrame.Angles(0, math.rad(90), 0)
    w3.Parent = handle
    
    local eyeLight = Instance.new("PointLight")
    eyeLight.Color = eyeColor
    eyeLight.Range = 10
    eyeLight.Brightness = 4
    eyeLight.Parent = eye
    
    -- ORB (сфера на конце)
    local orb = Instance.new("Part")
    orb.Name = "Orb"
    orb.Size = Vector3.new(0.7, 0.7, 0.7)
    orb.Color = orbColor
    orb.Material = Enum.Material.Neon
    orb.Shape = Enum.PartType.Ball
    orb.CFrame = head.CFrame * CFrame.new(0, 0, -0.9)
    orb.Parent = tool
    local w4 = Instance.new("Weld")
    w4.Part0 = handle
    w4.Part1 = orb
    w4.C0 = CFrame.new(0, 0.6, -3.5)
    w4.Parent = handle
    
    local orbLight = Instance.new("PointLight")
    orbLight.Color = orbColor
    orbLight.Range = 15
    orbLight.Brightness = 6
    orbLight.Parent = orb
    
    -- FLASK (колба сверху)
    local flask = Instance.new("Part")
    flask.Name = "Flask"
    flask.Size = Vector3.new(0.5, 1.1, 0.5)
    flask.Color = col
    flask.Material = Enum.Material.Neon
    flask.Shape = Enum.PartType.Cylinder
    flask.CFrame = body.CFrame * CFrame.new(0.2, 0.8, 0)
    flask.Parent = tool
    local w5 = Instance.new("Weld")
    w5.Part0 = handle
    w5.Part1 = flask
    w5.C0 = CFrame.new(0.2, 1.3, -0.8)
    w5.Parent = handle
    
    local flaskLight = Instance.new("PointLight")
    flaskLight.Color = col
    flaskLight.Range = 10
    flaskLight.Brightness = 4
    flaskLight.Parent = flask
    
    -- FLASK CAP
    local flaskCap = Instance.new("Part")
    flaskCap.Name = "FlaskCap"
    flaskCap.Size = Vector3.new(0.6, 0.15, 0.6)
    flaskCap.Color = Color3.fromRGB(200, 200, 200)
    flaskCap.Material = Enum.Material.SmoothPlastic
    flaskCap.Shape = Enum.PartType.Cylinder
    flaskCap.CFrame = flask.CFrame * CFrame.new(0, 0.65, 0)
    flaskCap.Parent = tool
    local w6 = Instance.new("Weld")
    w6.Part0 = handle
    w6.Part1 = flaskCap
    w6.C0 = CFrame.new(0.2, 1.95, -0.8)
    w6.Parent = handle
    
    -- GRIP (рукоятка снизу)
    local grip = Instance.new("Part")
    grip.Name = "Grip"
    grip.Size = Vector3.new(0.4, 0.8, 1)
    grip.Color = gripColor
    grip.Material = Enum.Material.SmoothPlastic
    grip.CFrame = handle.CFrame * CFrame.new(0, -0.7, 0.3)
    grip.Parent = tool
    local w7 = Instance.new("Weld")
    w7.Part0 = handle
    w7.Part1 = grip
    w7.C0 = CFrame.new(0, -0.7, 0.3)
    w7.Parent = handle
    
    -- RED BUTTON (только для Original)
    if skin == "Original" then
        local redBtn = Instance.new("Part")
        redBtn.Name = "RedButton"
        redBtn.Size = Vector3.new(0.4, 0.1, 0.3)
        redBtn.Color = Color3.fromRGB(220, 40, 40)
        redBtn.Material = Enum.Material.SmoothPlastic
        redBtn.CFrame = body.CFrame * CFrame.new(-0.3, 0.4, 0.3)
        redBtn.Parent = tool
        local w8 = Instance.new("Weld")
        w8.Part0 = handle
        w8.Part1 = redBtn
        w8.C0 = CFrame.new(-0.3, 0.9, -0.5)
        w8.Parent = handle
    end
    
    tool.Activated:Connect(function()
        local c = tool.Parent
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        if _G.BarnyPortal.Mode == "Normal" then
            if _G.BarnyPortal.NextPortal == "A" then
                local forward = hrp.CFrame.LookVector
                local spawnPos = hrp.Position + forward * 8
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {c}
                local groundCheck = workspace:Raycast(spawnPos + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0), rp)
                local normal = Vector3.new(0, 1, 0)
                if groundCheck then
                    spawnPos = Vector3.new(spawnPos.X, groundCheck.Position.Y + 5, spawnPos.Z)
                    normal = groundCheck.Normal
                end
                if _G.BarnyPortal.PortalA and _G.BarnyPortal.PortalA.Parent then _G.BarnyPortal.PortalA:Destroy() end
                _G.BarnyPortal.PortalA = CreatePortal(workspace, spawnPos, normal, "PortalA", _G.BarnyPortal.PortalColor)
                _G.BarnyPortal.NextPortal = "B"
            else
                local cam = workspace.CurrentCamera
                local origin = cam.CFrame.Position
                local direction = cam.CFrame.LookVector * 200
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {c}
                local res = workspace:Raycast(origin, direction, rp)
                if not res then return end
                local hp = res.Position
                local normal = res.Normal
                if _G.BarnyPortal.PortalB and _G.BarnyPortal.PortalB.Parent then _G.BarnyPortal.PortalB:Destroy() end
                _G.BarnyPortal.PortalB = CreatePortal(workspace, hp, normal, "PortalB", _G.BarnyPortal.PortalColor)
                _G.BarnyPortal.NextPortal = "A"
            end
            if _G.BarnyPortal.PortalA and _G.BarnyPortal.PortalB then
                SetupTP(_G.BarnyPortal.PortalA, _G.BarnyPortal.PortalB)
                SetupTP(_G.BarnyPortal.PortalB, _G.BarnyPortal.PortalA)
            end
        else
            if _G.BarnyPortal.EnterDimension then
                _G.BarnyPortal.EnterDimension(hrp)
            end
        end
    end)
    
    tool.Parent = LP:WaitForChild("Backpack")
    char.Humanoid:EquipTool(tool)
    _G.BarnyPortal.CurrentGun = tool
end

